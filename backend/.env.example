# Server
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed origins for production
# (e.g. https://medequip.com,https://admin.medequip.com). Leave blank in
# development to allow all origins. ALWAYS set this in production.
CORS_ORIGIN=

# MongoDB
MONGO_URI=mongodb://localhost:27017/medical_equipment_db

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Razorpay (final decision: Razorpay) — ACTIVE, required for the Payment Integration phase
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe — PLACEHOLDER ONLY. Not implemented in this project yet.
# Per project decision, Razorpay is the active gateway; these are reserved for future use.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# PayPal — PLACEHOLDER ONLY. Not implemented in this project yet.
# Per project decision, Razorpay is the active gateway; these are reserved for future use.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Order Tracking API - placeholder only, provider not finalized yet.
# utils/trackingService.js returns a mocked status until these are filled in
# with a real courier/tracking provider's credentials.
TRACKING_API_BASE_URL=
TRACKING_API_KEY=

# Tax rate applied at cart/checkout, as a decimal (e.g. 0.18 for 18% GST)
# PLACEHOLDER — set to 0 until the actual tax rule is confirmed with the client
TAX_RATE=0

# AI Chatbot - placeholder only, deferred for later phase
CHATBOT_API_KEY=
